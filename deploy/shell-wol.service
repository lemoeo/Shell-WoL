# Managed by Shell-WoL installer; @ROOT@ and @GROUP@ are rendered on install.
[Unit]
Description=Shell-WoL network wake manager
After=network.target

[Service]
Type=simple
User=shell-wol
Group=@GROUP@
WorkingDirectory="@ROOT@"
ExecStart="@ROOT@/bin/shell-wol" serve --data-dir "@ROOT@/data"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths="@ROOT@/data"
UMask=0077

[Install]
WantedBy=multi-user.target
